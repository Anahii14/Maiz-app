rules_version = '2';

// Reglas de seguridad de AgroCare.
// Cada usuario solo puede leer y escribir SUS propios datos.
// Todo lo que no esté permitido aquí abajo queda bloqueado.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validAnalysis(d) {
      return d.keys().hasOnly(['plantId', 'plantName', 'type', 'label', 'disease',
                               'confidence', 'affectionPercent', 'severity',
                               'date', 'photo', 'parcial', 'confianza_media',
                               'otras_posibilidades', 'tiempo_analisis_ms'])
        && (!('tiempo_analisis_ms' in d) || d.tiempo_analisis_ms == null
            || (d.tiempo_analisis_ms is int && d.tiempo_analisis_ms >= 0))
        && (!('parcial' in d) || d.parcial is bool)
        && (!('confianza_media' in d) || d.confianza_media is bool)
        && (!('otras_posibilidades' in d)
            || (d.otras_posibilidades is list && d.otras_posibilidades.size() <= 5))
        && d.label is string && d.label.size() > 0
        && d.confidence is number && d.confidence >= 0 && d.confidence <= 1
        && (d.affectionPercent == null
            || (d.affectionPercent is number
                && d.affectionPercent >= 0 && d.affectionPercent <= 100))
        && (d.severity == null || d.severity in ['leve', 'moderada', 'severa'])
        && d.date == request.time
        && (d.photo == null || (d.photo is bytes && d.photo.size() < 900 * 1024));
    }

    // Perfil del usuario: users/{uid}
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;

      // Plantas del usuario: users/{uid}/plants/{plantId}
      match /plants/{plantId} {
        allow read, write: if isOwner(userId);
      }

      // Análisis de hojas: users/{uid}/analyses/{analysisId}
      // Solo se aceptan análisis con el formato del modelo real.
      match /analyses/{analysisId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validAnalysis(request.resource.data);
        allow update, delete: if false;
      }
    }

    // Cualquier otra ruta: prohibida.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
